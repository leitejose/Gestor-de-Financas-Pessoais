# ====================================
# CONFIGURAÇÕES DO AMBIENTE
# ====================================

# Porta do servidor
PORT=3000

# Configurações do SQL Server
DB_SERVER=localhost
DB_NAME=GestorFinancas
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_PORT=1433

# Para Windows Authentication (comentar USER e PASSWORD acima)
# DB_TRUSTED_CONNECTION=true

# Para SQL Server Express
# DB_SERVER=localhost\\SQLEXPRESS

# JWT Secret (gere uma chave segura em produção)
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_123456

# Ambiente
NODE_ENV=development

# CORS Origins (separar por vírgula)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de Log
LOG_LEVEL=info
LOG_FILE=logs/app.log
